generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN_ADMINISTRASI
  ADMIN_KEUANGAN
  WARGA
}

model User {
  id          Int      @id @default(autoincrement())
  noTelepon   String?  @unique // Digunakan sebagai username login warga
  email       String?  @unique // Digunakan sebagai username login admin (RT, Sekretaris, Bendahara)
  name        String?
  role        Role     @default(WARGA)
  password    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  otpCode     String?
  otpExpiry   DateTime?
  
  warga       Warga?
  pengumuman  Pengumuman[]
  notifikasi  Notifikasi[]
  laporanDibuat  Laporan[] @relation("LaporanPembuat")
  laporanDisetujui Laporan[] @relation("LaporanPenyetuju")
}

model Warga {
  id              Int       @id @default(autoincrement())
  noRumah         String?   // Nomor/alamat rumah warga
  noKK            String    @unique
  kepalaKeluarga  String
  jumlahAnggota   Int       @default(1)
  noTelepon       String?
  statusRumah     String    @default("MILIK_SENDIRI") // MILIK_SENDIRI, SEWA, KONTRAK
  userId          Int       @unique
  user            User      @relation(fields: [userId], references: [id])
  tagihan         Tagihan[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model IuranMaster {
  id        Int      @id @default(autoincrement())
  nama      String   // e.g., "Keamanan", "Kebersihan", "Sosial"
  nominal   Float
  periode   String   @default("BULANAN") // BULANAN, MINGGUAN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StatusTagihan {
  BELUM_LUNAS
  LUNAS
  TUNGGAKAN
}

model Tagihan {
  id            Int           @id @default(autoincrement())
  wargaId       Int
  warga         Warga         @relation(fields: [wargaId], references: [id])
  bulan         Int
  tahun         Int
  totalNominal  Float
  status        StatusTagihan @default(BELUM_LUNAS)
  pembayaran    Pembayaran[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum StatusPembayaran {
  PENDING
  SUCCESS
  FAILED
}

model Pembayaran {
  id              Int              @id @default(autoincrement())
  tagihanId       Int
  tagihan         Tagihan          @relation(fields: [tagihanId], references: [id])
  metode          String           // "CASH", "TRANSFER", "QRIS"
  jumlahBayar     Float
  tanggalBayar    DateTime?
  referenceId     String?          @unique // untuk payment gateway
  status          StatusPembayaran @default(PENDING)
  buktiUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum JenisKas {
  PEMASUKAN
  PENGELUARAN
}

model KasHarian {
  id          Int      @id @default(autoincrement())
  tanggal     DateTime @default(now())
  jenis       JenisKas
  kategori    String   // "IURAN", "DONASI", "OPERASIONAL"
  keterangan  String
  nominal     Float
  buktiUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pengumuman {
  id          Int      @id @default(autoincrement())
  title       String
  content     String
  type        String   @default("INFO") // INFO, EVENT
  targetRole  String   @default("ALL")  // ALL, WARGA, ADMIN_KEUANGAN, SUPER_ADMIN
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notifikasi {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  isRead      Boolean  @default(false)
  userId      Int      // Target penerima notif (Warga / Bendahara)
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StatusLaporan {
  PENDING
  APPROVED
  REVISI
}

model Laporan {
  id          Int            @id @default(autoincrement())
  title       String
  fileUrl     String?        // Link PDF yang di-export bendahara
  bulan       Int
  tahun       Int
  status      StatusLaporan  @default(PENDING)
  komentar    String?        // Field comment dari RT jika REVISI
  
  pembuatId   Int            // Bendahara yang buat
  pembuat     User           @relation("LaporanPembuat", fields: [pembuatId], references: [id])
  
  penyetujuId Int?           // RT yang approve
  penyetuju   User?          @relation("LaporanPenyetuju", fields: [penyetujuId], references: [id])
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
